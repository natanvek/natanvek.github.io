---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { categories } from '../../categories';
import { stripTags } from '../../lib/html';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf(),
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { title, tagline, category, period, award, tags, stats, links, logo, cover, gallery } = project.data;
const cat = categories[category];
const { Content } = await render(project);
// Processed (resized, metadata-stripped) versions for the lightbox, never the originals
const fullSizes = await Promise.all(gallery.map((g) => getImage({ src: g.src, width: 1800, format: 'webp' })));
---
<Base title={stripTags(title)} description={tagline}>
  <article class="container" style={`--cat: ${cat.color}`}>
    <a href="/projects/" class="back mono">← all work</a>

    <header class="head">
      {logo && <Image src={logo} alt="" height={144} class="logo" />}
      <div class="meta mono">
        <span class="cat"><span class="dot"></span>{cat.label}</span>
        <span>{period}</span>
      </div>
      {award && <div class="award">🏆 {award}</div>}
      <h1 set:html={title} />
      <p class="tagline">{tagline}</p>
      {links.length > 0 && (
        <div class="links">
          {links.map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
        </div>
      )}
    </header>

    {cover && (
      <figure class="cover">
        <Image src={cover.src} alt={cover.alt} widths={[800, 1400, 2000]} sizes="(max-width: 1120px) 100vw, 1072px" loading="eager" />
      </figure>
    )}

    {stats.length > 0 && (
      <div class="stats">
        {stats.map((s) => (
          <div class="stat glow-card">
            <span class="v" set:html={s.value} />
            <span class="l" set:html={s.label} />
          </div>
        ))}
      </div>
    )}

    <div class="layout">
      <div class="prose"><Content /></div>
      <aside>
        <p class="eyebrow">Stack &amp; topics</p>
        <div class="tags">{tags.map((t) => <span class="chip">{t}</span>)}</div>
      </aside>
    </div>

    {gallery.length > 0 && (
      <section class="gallery-wrap">
        <p class="eyebrow">Gallery</p>
        <div class="gallery">
          {gallery.map((g, i) => (
            <figure>
              <button class="zoom" data-full={fullSizes[i].src} data-alt={g.alt} aria-label={`Enlarge: ${g.alt}`}>
                <Image src={g.src} alt={g.alt} widths={[480, 900]} sizes="(max-width: 620px) 100vw, 360px" />
              </button>
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
        <dialog class="lightbox"><img alt="" /><button class="close mono" aria-label="Close">✕</button></dialog>
      </section>
    )}

    <nav class="pager">
      {prev ? <a class="glow-card" href={`/projects/${prev.id}/`}><span class="mono">← newer</span><Fragment set:html={prev.data.title} /></a> : <span />}
      {next ? <a class="glow-card right" href={`/projects/${next.id}/`}><span class="mono">older →</span><Fragment set:html={next.data.title} /></a> : <span />}
    </nav>
  </article>
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dlg) {
    const img = dlg.querySelector('img')!;
    document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((b) =>
      b.addEventListener('click', () => {
        img.src = b.dataset.full!;
        img.alt = b.dataset.alt!;
        dlg.showModal();
      }),
    );
    dlg.addEventListener('click', () => dlg.close());
  }
</script>

<style>
  article { padding-top: 48px; padding-bottom: 96px; }
  .back { color: var(--muted); font-size: 14px; }
  .back:hover { color: var(--cat); }
  .head { padding: 48px 0 40px; max-width: 820px; }
  .meta { display: flex; gap: 18px; font-size: 13px; color: var(--muted); align-items: center; }
  .cat { color: var(--cat); display: inline-flex; gap: 8px; align-items: center; text-transform: uppercase; letter-spacing: 0.1em; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cat); box-shadow: 0 0 12px var(--cat); }
  .award {
    display: inline-block;
    margin-top: 22px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 999px;
    color: var(--award-text);
    background: var(--award-bg);
    border: 1px solid var(--award-border);
  }
  h1 { font-size: clamp(38px, 6.5vw, 72px); line-height: 1.02; letter-spacing: -0.04em; margin: 18px 0 18px; }
  .tagline { font-size: 21px; color: var(--muted); margin: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

  .logo { display: block; height: 72px; width: auto; border-radius: 14px; margin-bottom: 22px; box-shadow: var(--shadow); }
  .cover { margin: 0 0 40px; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); }
  .cover img { display: block; width: 100%; height: auto; max-height: 560px; object-fit: cover; }

  .gallery-wrap { margin-top: 72px; }
  .gallery { columns: 3 300px; column-gap: 16px; margin-top: 18px; }
  .gallery figure { margin: 0 0 16px; break-inside: avoid; }
  .zoom { display: block; width: 100%; padding: 0; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; cursor: zoom-in; background: none; }
  .zoom img { display: block; width: 100%; height: auto; transition: transform 0.5s; }
  .zoom:hover img { transform: scale(1.04); }
  .gallery figcaption { color: var(--muted); font-size: 14px; margin-top: 8px; }
  .lightbox { padding: 0; border: none; background: none; max-width: 94vw; max-height: 92vh; overflow: visible; }
  .lightbox::backdrop { background: var(--backdrop); backdrop-filter: blur(6px); }
  .lightbox img { display: block; max-width: 94vw; max-height: 92vh; border-radius: 12px; }
  .lightbox .close { position: absolute; top: -14px; right: -14px; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border-strong); background: var(--surface-solid); color: var(--text); cursor: pointer; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 56px; }
  .stat { padding: 22px; display: flex; flex-direction: column; }
  .stat .v { font-size: 34px; font-weight: 700; letter-spacing: -0.03em; color: var(--cat); line-height: 1.15; }
  .stat .l { color: var(--muted); font-size: 14px; }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 64px; }
  aside { position: sticky; top: 96px; align-self: start; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }

  .prose { max-width: 720px; font-size: 18px; }
  .prose :global(h2) { font-size: 28px; letter-spacing: -0.02em; margin: 48px 0 14px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 21px; margin: 32px 0 10px; }
  .prose :global(p), .prose :global(li) { color: var(--body-text); }
  .prose :global(ul) { padding-left: 22px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(li::marker) { color: var(--cat); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(a) { color: var(--cat); border-bottom: 1px solid currentColor; }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--code-bg);
  }
  .prose :global(blockquote) {
    margin: 28px 0;
    padding: 18px 22px;
    border-left: 3px solid var(--cat);
    background: var(--bg-elev);
    border-radius: 0 12px 12px 0;
  }
  .prose :global(blockquote p) { margin: 0; color: var(--text); }
  .prose :global(img) { display: block; width: 100%; height: auto; margin: 28px 0 6px; padding: 18px; border-radius: 14px; background: var(--surface-solid); border: 1px solid var(--border); box-sizing: border-box; }
  .prose :global(img + em), .prose :global(p:has(> img) + p > em:only-child) { display: block; color: var(--muted); font-size: 14.5px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 80px; }
  .pager a { padding: 22px; display: flex; flex-direction: column; gap: 4px; font-weight: 600; }
  .pager a span { color: var(--muted); font-size: 13px; font-weight: 400; }
  .pager .right { text-align: right; }

  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; gap: 32px; }
    aside { position: static; order: -1; }
    .pager { grid-template-columns: 1fr; }
  }
</style>
