---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist.">
  <section class="section container notfound">
    <p class="eyebrow">404</p>
    <h1 class="section-title">No path to this vertex.</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <div class="cta">
      <a class="btn primary" href="/">Go home</a>
      <a class="btn" href="/projects/">See my work</a>
    </div>
  </section>
</Base>

<style>
  .notfound { min-height: 60vh; }
  .notfound p { color: var(--muted); margin: 0 0 28px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
